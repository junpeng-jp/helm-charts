{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry":    { "type": "string" },
            "repository":  { "type": "string" },
            "tag":         { "type": "string" },
            "digest":      { "type": "string" },
            "pullPolicy":  { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
            "pullSecrets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "testImage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry":   { "type": "string" },
            "repository": { "type": "string" },
            "tag":        { "type": "string" },
            "digest":     { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        }
      }
    },
    "nameOverride":     { "type": "string", "minLength": 1, "maxLength": 63 },
    "fullnameOverride": { "type": "string", "minLength": 1, "maxLength": 63 },
    "replicaCount":          { "type": "integer", "minimum": 1 },
    "podManagementPolicy":   { "type": "string", "enum": ["OrderedReady", "Parallel"] },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "OnDelete"] },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "partition": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create":      { "type": "boolean" },
        "name":        { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "initContainers": { "type": "array" },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":      { "type": "string" },
          "value":     { "type": "string" },
          "valueFrom": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "secretVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["secretName"],
        "additionalProperties": false,
        "properties": {
          "secretName": { "type": "string" },
          "mountPath":  { "type": "string", "pattern": "^[^/]" },
          "name":       { "type": "string" }
        }
      }
    },
    "extraVolumes":      { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory": { "type": "string" },
            "cpu":    { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory": { "type": "string" },
            "cpu":    { "type": "string" }
          }
        }
      }
    },
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations":  { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations":  { "type": "array" },
        "affinity":     { "type": "object" },
        "hostNetwork":  { "type": "boolean" }
      }
    },
    "networking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headlessService": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publishNotReadyAddresses": { "type": "boolean" }
          }
        },
        "service": {
          "type": "object",
          "required": ["app"],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "type": {
                "type": "string",
                "enum": ["ClusterIP", "LoadBalancer", "NodePort"]
              },
              "ports": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["port", "protocol"],
                  "properties": {
                    "port":     { "type": "integer" },
                    "protocol": { "type": "string", "enum": ["TCP", "UDP"] },
                    "enabled":  { "type": "boolean" }
                  }
                }
              }
            },
            "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
            "then": { "required": ["ports"], "properties": { "ports": { "minProperties": 1 } } }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":    { "type": "boolean" },
            "parentRefs": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
            "hostnames":  { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          },
          "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "required": ["hostnames", "parentRefs"] }
        },
        "traefik": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":     { "type": "boolean" },
            "entryPoints": { "type": "array", "items": { "type": "string" } },
            "hostnames":   { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "middlewares": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name":      { "type": "string" },
                  "namespace": { "type": "string" }
                }
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled":      { "type": "boolean" },
                "secretName":   { "type": "string" },
                "certResolver": { "type": "string" }
              },
              "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "anyOf": [
                  { "required": ["secretName"],   "properties": { "secretName":   { "minLength": 1 } } },
                  { "required": ["certResolver"], "properties": { "certResolver": { "minLength": 1 } } }
                ]
              }
            }
          },
          "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "required": ["hostnames"] }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":       { "type": "boolean" },
        "storageClass":  { "type": "string" },
        "accessModes":   { "type": "array", "items": { "type": "string" } },
        "size":          { "type": "string" },
        "annotations":   { "type": "object" },
        "labels":        { "type": "object" },
        "existingClaim":  { "type": "string" },
        "existingVolume": { "type": "string" }
      },
      "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "anyOf": [
          { "required": ["existingClaim"], "properties": { "existingClaim": { "minLength": 1 } } },
          { "required": ["size"],         "properties": { "size":          { "minLength": 1 } } }
        ]
      },
      "not": {
        "allOf": [
          { "properties": { "existingClaim":  { "minLength": 1 } }, "required": ["existingClaim"] },
          { "properties": { "existingVolume": { "minLength": 1 } }, "required": ["existingVolume"] }
        ]
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":       { "type": "boolean" },
            "path":          { "type": "string" },
            "port":          { "type": "string" },
            "interval":      { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels":        { "type": "object" }
          },
          "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "required": ["path", "port"],
            "properties": {
              "path": { "minLength": 1 },
              "port": { "minLength": 1 }
            }
          }
        }
      }
    },
    "homeAssistant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initContainer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "registry":   { "type": "string" },
                "repository": { "type": "string" },
                "tag":        { "type": "string" },
                "digest":     { "type": "string" },
                "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "memory": { "type": "string" },
                    "cpu":    { "type": "string" }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "memory": { "type": "string" },
                    "cpu":    { "type": "string" }
                  }
                }
              }
            },
            "tasks": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "setupHACS": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "version": { "type": "string" },
                    "sha256":  { "type": "string" }
                  },
                  "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": {
                    "required": ["version"],
                    "properties": { "version": { "minLength": 1 } }
                  }
                },
                "setupSecretsYaml": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled":    { "type": "boolean" },
                    "secretName": { "type": "string" }
                  },
                  "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": {
                    "required": ["secretName"],
                    "properties": { "secretName": { "minLength": 1 } }
                  }
                },
                "gitops": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "repo": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name":           { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
                        "url":            { "type": "string" },
                        "allowedSigners": { "type": "string" }
                      }
                    },
                    "ssh": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "secretName":  { "type": "string" },
                        "secretKey":   { "type": "string", "minLength": 1 },
                        "knownHosts":  { "type": "string" }
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                      "then": {
                        "required": ["repo"],
                        "properties": {
                          "repo": {
                            "required": ["name", "url"],
                            "properties": {
                              "name": { "minLength": 1 },
                              "url":  { "minLength": 1 }
                            }
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "enabled": { "const": true },
                          "repo": {
                            "required": ["url"],
                            "properties": { "url": { "pattern": "^(git@|ssh://)" } }
                          }
                        },
                        "required": ["enabled", "repo"]
                      },
                      "then": {
                        "required": ["ssh"],
                        "properties": {
                          "ssh": {
                            "required": ["knownHosts", "secretName"],
                            "properties": {
                              "knownHosts": { "minLength": 1 },
                              "secretName": { "minLength": 1 }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "content": { "type": "string" },
            "checkConfig": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "resources": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requests": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "memory": { "type": "string" },
                        "cpu":    { "type": "string" }
                      }
                    },
                    "limits": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "memory": { "type": "string" },
                        "cpu":    { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "required": ["content"],
            "properties": { "content": { "minLength": 1 } }
          }
        }
      }
    }
  }
}
