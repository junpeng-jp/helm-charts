#!/bin/sh
set -eu

CONFIG_DIR="/config"
GITOPS_BASE="${CONFIG_DIR}/.gitops"
SCRIPT_SRC="/run/gitops/gitops"

# Only state/ is preserved across restarts.
rm -rf "${GITOPS_BASE}/run"
mkdir -p "${GITOPS_BASE}/run/allowed-signers" \
         "${GITOPS_BASE}/run/bin"
cp "$SCRIPT_SRC" "${GITOPS_BASE}/run/bin/gitops"
chmod +x "${GITOPS_BASE}/run/bin/gitops"

for _as in /run/gitops-signers/*; do
  [ -f "$_as" ] || continue
  cp "$_as" "${GITOPS_BASE}/run/allowed-signers/${_as##*/}"
done

_KNOWN_HOSTS="/run/gitops/knownHosts"
if [ -f "$_KNOWN_HOSTS" ]; then
  cp "$_KNOWN_HOSTS" "${GITOPS_BASE}/run/known_hosts"
  cp /run/gitops/ssh-repos "${GITOPS_BASE}/run/ssh-repos"
  {
    printf 'Host *\n'
    printf '  IdentityFile /run/secrets/gitops/ssh_key\n'
    printf '  UserKnownHostsFile %s/run/known_hosts\n' "$GITOPS_BASE"
    printf '  StrictHostKeyChecking yes\n'
    printf '  IdentitiesOnly yes\n'
  } > "${GITOPS_BASE}/run/ssh_config"
  [ -r /run/secrets/gitops/ssh_key ] \
    || { printf 'ERROR: SSH key not found at /run/secrets/gitops/ssh_key\n' >&2; exit 1; }
fi

# Prune symlinks in /config/gitops/ for repos no longer in the configured list.
if [ -d "${CONFIG_DIR}/gitops" ]; then
  for _link in "${CONFIG_DIR}/gitops/"*; do
    [ -L "$_link" ] || continue
    _repo_name="${_link##*/}"
    if ! grep -qxF "$_repo_name" /run/gitops/repos 2>/dev/null; then
      printf 'WARNING: pruning stale gitops symlink for removed repo "%s"\n' "$_repo_name" >&2
      rm -f "$_link"
    fi
  done
fi

while IFS= read -r _repo; do
  [ -z "$_repo" ] && continue
  if [ ! -d "${GITOPS_BASE}/repos/${_repo}.git/objects" ]; then
    printf 'INFO: repo "%s" not yet cloned. Run: gitops clone %s <url>\n' "$_repo" "$_repo" >&2
  fi
done < /run/gitops/repos
